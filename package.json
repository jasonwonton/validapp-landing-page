{
  "name": "validapp-landing-page",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "start": "node scripts/serve-production.mjs",
    "start:staging": "node scripts/serve-staging.mjs",
    "test:staging": "node --test scripts/tests/staging-origin.test.mjs",
    "test:static-origin": "node --test scripts/tests/static-origin.test.mjs scripts/tests/version-static-assets.test.mjs",
    "test:performance": "node scripts/check-performance-budgets.mjs",
    "test:ui-runtime": "node scripts/test-ui-runtime.mjs",
    "test:e2e": "playwright test",
    "test:e2e:deployed": "playwright test --config=playwright.deployed.config.js",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:passkey-integration": "node scripts/test-passkey-backend.mjs",
    "test:production": "node scripts/check-production.mjs",
    "test:seo": "node --test scripts/tests/seo.test.mjs",
    "test:auth-recovery": "node --test scripts/tests/auth-route-policy.test.mjs scripts/tests/auth-route-recovery.test.mjs scripts/tests/session-recovery.test.mjs",
    "test:weekly-game": "node --test scripts/tests/weekly-game.test.mjs scripts/tests/weekly-game-v2.test.mjs && playwright test tests/weekly-game.spec.js tests/weekly-game-v2.spec.js",
    "test:foundations": "node --test scripts/tests/media-url.test.mjs scripts/tests/user-message.test.mjs",
    "test:shell": "node --test scripts/tests/service-worker-shell.test.mjs scripts/tests/service-worker-media-cache.test.mjs",
    "test:play": "node --test scripts/tests/play-choices.test.mjs && playwright test tests/play-contacts.spec.js",
    "test:attribution": "node --test scripts/tests/question-attribution.test.mjs && playwright test tests/anonymous-attribution.spec.js",
    "lint": "eslint app/app.js app/api.js app/chat/index.js app/chat/outbox.js app/chat/people.js app/chat/activity-settings.js app/camera/send-to.js app/comments/index.js app/routes/feed.js app/routes/chats.js app/demo-api.js app/ui-icons.js app/ui-dialogs.js assets/add-link.js app/friends/index.js app/friends/model.js app/activity.js app/ask-compose.js app/parent-access.js app/parent-approval.js app/chat/direct-draft.js app/chat/drafts.js app/college-majors.js",
    "typecheck": "tsc -p tsconfig.parity.json",
    "test:unit": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "livekit-client": "^2.22.2",
    "qrcode": "^1.5.4"
  }
}
